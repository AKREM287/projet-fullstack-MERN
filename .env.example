# Copiez ce fichier en ".env" puis adaptez les valeurs
PORT=8080
DEV_MODE=development
# MongoDB local :
MONGO_URL=mongodb://127.0.0.1:27017/bloodbank
# ou MongoDB Atlas : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bloodbank
JWT_SECRET=changez-moi-par-une-longue-phrase-secrete
JWT_EXPIRES_IN=1d
# Code à saisir pour pouvoir créer un compte ADMIN depuis le formulaire d'inscription
ADMIN_CODE=admin123
